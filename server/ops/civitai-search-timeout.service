[Unit]
Description=60-second limit for root SSH diagnostic file searches
After=sshd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/civitai-search-timeout.py
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=64M
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
